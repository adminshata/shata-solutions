// Shata Restaurant OS — Prisma Schema
// Global-first: currency, locale, timezone, taxRate per restaurant — never hardcoded
// Tenant isolation: every table has restaurantId; RLS enabled at DB level

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Organization / Tenant Hierarchy ───────────────────────────────────────

model Organization {
  id            String        @id @default(cuid())
  name          String
  plan          PlanType      @default(STARTER)
  billingStatus String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  restaurants   Restaurant[]
  subscription  Subscription?
}

model Restaurant {
  id           String     @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  branchCode   String?
  slug         String?    @unique

  // Localization — every field is per-restaurant, never global
  currency     String     @default("USD")    // ISO 4217
  locale       String     @default("en")     // BCP-47
  timezone     String     @default("UTC")    // IANA tz
  taxRate      Decimal    @db.Decimal(5, 4)  @default(0)      // e.g. 0.14 = 14%
  taxLabel     String     @default("Tax")    // "VAT", "GST", "Sales Tax"
  taxInclusive Boolean    @default(false)

  settings     Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tables         Table[]
  sessions       Session[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  staff          Staff[]
  kitchenTickets KitchenTicket[]
  transactions   Transaction[]
  stampCards     StampCard[]

  @@index([orgId])
}

// ── Tables & Sessions ─────────────────────────────────────────────────────

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       String
  label        String?
  qrCode       String      @unique
  nfcId        String?     @unique
  status       TableStatus @default(AVAILABLE)
  capacity     Int?
  positionX    Float?
  positionY    Float?
  createdAt    DateTime    @default(now())
  sessions     Session[]

  @@index([restaurantId, status])
}

model Session {
  id           String        @id @default(cuid())
  tableId      String
  table        Table         @relation(fields: [tableId], references: [id])
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  status       SessionStatus @default(ACTIVE)
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  orders       Order[]

  @@unique([tableId, status], name: "active_session_per_table")
  @@index([restaurantId, status])
  @@index([tableId, status])
}

// ── Menu ──────────────────────────────────────────────────────────────────

model Category {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String?
  description   String?
  imageUrl      String?
  sortOrder     Int        @default(0)
  availableFrom String?
  availableTo   String?
  isAvailable   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  products      Product[]

  @@index([restaurantId, isAvailable])
}

model Product {
  id              String     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category   @relation(fields: [categoryId], references: [id])
  name            String
  nameAr          String?
  description     String?
  descriptionAr   String?
  price           Decimal    @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  calories        Int?
  avgPrepMinutes  Int        @default(10)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  modifierGroups  ModifierGroup[]
  orderItems      OrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
}

model ModifierGroup {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  nameAr     String?
  type       ModifierType
  required   Boolean        @default(false)
  minSelect  Int            @default(0)
  maxSelect  Int            @default(1)
  sortOrder  Int            @default(0)
  options    ModifierOption[]
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  nameAr          String?
  priceDelta      Decimal       @db.Decimal(10, 2) @default(0)
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)
}

// ── Orders ────────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int
  sessionId    String?
  session      Session?    @relation(fields: [sessionId], references: [id])
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  customerId   String?
  status       OrderStatus @default(PENDING)
  type         OrderType   @default(DINE_IN)
  // Currency copied from restaurant at order creation — immutable after creation
  currency     String
  subtotal     Decimal     @db.Decimal(10, 2)
  tax          Decimal     @db.Decimal(10, 2) @default(0)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?
  voidReason   String?
  tipAmount    Decimal     @db.Decimal(10, 2) @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  payment      PaymentIntent?
  kitchenTicket KitchenTicket?
  tip          Tip?
  refunds      Refund[]

  @@index([restaurantId, status])
  @@index([sessionId])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal             @db.Decimal(10, 2)
  totalPrice      Decimal             @db.Decimal(10, 2)
  notes           String?
  selectedOptions OrderItemModifier[]
}

model OrderItemModifier {
  id               String      @id @default(cuid())
  orderItemId      String
  orderItem        OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId String
  name             String
  priceDelta       Decimal     @db.Decimal(10, 2)
}

// ── Payments ──────────────────────────────────────────────────────────────

model PaymentIntent {
  id           String          @id @default(cuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id])
  provider     PaymentProvider
  providerRef  String?
  amount       Decimal         @db.Decimal(10, 2)
  currency     String
  status       PaymentStatus   @default(PENDING)
  metadata     Json?
  idempotencyKey String?       @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  settledAt    DateTime?

  @@index([orderId])
  @@index([provider, providerRef])
}

model Transaction {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  currency     String
  fee          Decimal         @db.Decimal(10, 2) @default(0)
  net          Decimal         @db.Decimal(10, 2)
  refId        String?
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, type])
}

// ── Kitchen ───────────────────────────────────────────────────────────────

model KitchenTicket {
  id            String       @id @default(cuid())
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id])
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id])
  station       String?
  status        TicketStatus @default(PENDING)
  priority      Int          @default(0)
  prepStartedAt DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, station, status])
}

// ── Staff ─────────────────────────────────────────────────────────────────

model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  clerkUserId  String     @unique
  name         String
  email        String?
  role         StaffRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, isActive])
}

// ── Customer & Loyalty ────────────────────────────────────────────────────

model Customer {
  id              String           @id @default(cuid())
  phone           String           @unique
  name            String?
  email           String?
  createdAt       DateTime         @default(now())
  loyaltyAccounts LoyaltyAccount[]
}

model LoyaltyAccount {
  id            String               @id @default(cuid())
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  restaurantId  String
  points        Int                  @default(0)
  walletBalance Decimal              @db.Decimal(10, 2) @default(0)
  currency      String
  createdAt     DateTime             @default(now())
  transactions  LoyaltyTransaction[]

  @@unique([customerId, restaurantId])
  @@index([restaurantId])
}

model LoyaltyTransaction {
  id               String         @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])
  type             LoyaltyTxType
  pointsDelta      Int
  refOrderId       String?
  note             String?
  createdAt        DateTime       @default(now())

  @@index([loyaltyAccountId])
}

// ── Phase 2: Stamp Card Loyalty ───────────────────────────────────────────

model StampCard {
  id               String             @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId       String
  stamps           Int                @default(0)
  stampsRequired   Int                @default(10)
  rewardType       RewardType         @default(FREE_ITEM)
  rewardProductId  String?
  rewardDiscount   Decimal?           @db.Decimal(5, 2)
  isRedeemed       Boolean            @default(false)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  transactions     StampTransaction[]

  @@unique([restaurantId, customerId])
  @@index([restaurantId])
}

model StampTransaction {
  id          String    @id @default(cuid())
  stampCardId String
  stampCard   StampCard @relation(fields: [stampCardId], references: [id], onDelete: Cascade)
  orderId     String
  stampsAdded Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([stampCardId])
}

// ── Phase 2: Analytics Snapshot (pre-computed daily stats) ────────────────

model AnalyticsSnapshot {
  id                 String   @id @default(cuid())
  restaurantId       String
  date               DateTime @db.Date
  totalOrders        Int
  totalRevenue       Decimal  @db.Decimal(12, 2)
  avgOrderValue      Decimal  @db.Decimal(10, 2)
  topProducts        Json     @default("[]")
  peakHour           Int      @default(0)
  newCustomers       Int      @default(0)
  returningCustomers Int      @default(0)
  createdAt          DateTime @default(now())

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

// ── Phase 2: Z-Report (daily settlement) ─────────────────────────────────

model ZReport {
  id           String   @id @default(cuid())
  restaurantId String
  date         DateTime @db.Date
  pdfUrl       String   @default("")
  totalOrders  Int
  totalRevenue Decimal  @db.Decimal(12, 2)
  totalTax     Decimal  @db.Decimal(12, 2)
  totalRefunds Decimal  @db.Decimal(12, 2)
  netRevenue   Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

// ── Phase 2: Thermal Printer Config ───────────────────────────────────────

model PrinterConfig {
  id           String      @id @default(cuid())
  restaurantId String      @unique
  type         PrinterType @default(NETWORK)
  ipAddress    String?
  port         Int?        @default(9100)
  usbPath      String?
  isActive     Boolean     @default(true)
  printOnOrder Boolean     @default(true)
  printReceipt Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ── Phase 2: Customer Devices (Push Notifications) ────────────────────────

model CustomerDevice {
  id           String   @id @default(cuid())
  customerId   String
  onesignalId  String   @unique
  platform     String
  restaurantId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([restaurantId])
}

// ── Phase 2: Menu Branch Overrides (per-branch price/availability) ────────

model ProductBranchOverride {
  id           String   @id @default(cuid())
  productId    String
  restaurantId String
  price        Decimal? @db.Decimal(10, 2)
  isAvailable  Boolean?
  createdAt    DateTime @default(now())

  @@unique([productId, restaurantId])
  @@index([restaurantId])
}

// ── Phase 2: Tips ─────────────────────────────────────────────────────────

model Tip {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String
  amount       Decimal  @db.Decimal(10, 2)
  percentage   Int?
  createdAt    DateTime @default(now())

  @@index([restaurantId])
}

// ── Phase 2: Payment Links ────────────────────────────────────────────────

model PaymentLink {
  id            String     @id @default(cuid())
  restaurantId  String
  token         String     @unique @default(cuid())
  amount        Decimal    @db.Decimal(10, 2)
  currency      String     @default("USD")
  description   String?
  customerName  String?
  customerPhone String?
  status        LinkStatus @default(PENDING)
  expiresAt     DateTime
  paidAt        DateTime?
  orderId       String?
  createdAt     DateTime   @default(now())

  @@index([restaurantId])
  @@index([token])
}

// ── Phase 2: Webhook System ───────────────────────────────────────────────

model WebhookEndpoint {
  id           String            @id @default(cuid())
  restaurantId String
  url          String
  events       String[]
  secret       String            @default(cuid())
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  deliveries   WebhookDelivery[]

  @@index([restaurantId])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempts       Int             @default(0)
  succeededAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([endpointId])
  @@index([nextRetryAt])
}

// ── Subscription ──────────────────────────────────────────────────────────

model Subscription {
  id                     String       @id @default(cuid())
  orgId                  String       @unique
  org                    Organization @relation(fields: [orgId], references: [id])
  planType               PlanType
  status                 SubStatus    @default(ACTIVE)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  providerSubscriptionId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum PlanType {
  STARTER
  GROWTH
  ENTERPRISE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  CLOSED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COOKING
  READY
  SERVED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
  STAFF_ENTRY
}

enum PaymentProvider {
  STRIPE
  PAYMOB
  FAWRY
  TABBY
  TAMARA
  INSTAPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  FEE
  PAYOUT
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  READY
  SERVED
}

enum ModifierType {
  SINGLE
  MULTI
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

enum LoyaltyTxType {
  EARN
  REDEEM
  REFUND
  ADJUSTMENT
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum RewardType {
  FREE_ITEM
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
}

enum PrinterType {
  NETWORK
  USB
}

enum LinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

// ── Phase 3: Refund Flow ──────────────────────────────────────────────────

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  restaurantId    String
  paymentIntentId String
  amount          Decimal      @db.Decimal(10, 2)
  reason          RefundReason
  notes           String?
  status          RefundStatus @default(PENDING_APPROVAL)
  initiatedBy     String
  approvedBy      String?
  providerRefId   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())

  @@index([restaurantId, status])
  @@index([orderId])
}

enum RefundReason {
  WRONG_ITEM
  QUALITY_ISSUE
  CUSTOMER_CANCELLED
  DUPLICATE_PAYMENT
  OTHER
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

// ── Phase 3: NFC Tags ─────────────────────────────────────────────────────

model NfcTag {
  id           String    @id @default(cuid())
  restaurantId String
  serialNumber String    @unique
  tableId      String?   @unique
  status       NfcStatus @default(UNASSIGNED)
  programmedAt DateTime?
  lastScanned  DateTime?
  scanCount    Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([restaurantId])
  @@index([restaurantId, status])
}

enum NfcStatus {
  UNASSIGNED
  ASSIGNED
  ACTIVE
  DAMAGED
  LOST
}

// ── Phase 3: Subscription Billing ────────────────────────────────────────

model Invoice {
  id                String        @id @default(cuid())
  orgId             String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EGP")
  status            InvoiceStatus @default(DRAFT)
  dueDate           DateTime
  paidAt            DateTime?
  pdfUrl            String?
  lineItems         Json
  providerInvoiceId String?
  createdAt         DateTime      @default(now())

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  orgId       String
  type        String
  last4       String?
  brand       String?
  isDefault   Boolean  @default(false)
  providerRef String?
  createdAt   DateTime @default(now())

  @@index([orgId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ── Phase 3: InstaPay Pending Confirmations ───────────────────────────────

model InstapayPendingConfirmation {
  id           String    @id @default(cuid())
  orderId      String    @unique
  restaurantId String
  amount       Decimal   @db.Decimal(10, 2)
  expiresAt    DateTime
  confirmedBy  String?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([restaurantId])
  @@index([expiresAt])
}
