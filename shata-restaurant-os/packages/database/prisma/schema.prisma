generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  plan             PlanType          @default(STARTER)
  billingStatus    String            @default("active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  restaurants      Restaurant[]
  subscription     Subscription?
  whiteLabelConfig WhiteLabelConfig?
}

model Restaurant {
  id             String          @id @default(cuid())
  orgId          String
  name           String
  branchCode     String?
  slug           String?         @unique
  currency       String          @default("USD")
  locale         String          @default("en")
  timezone       String          @default("UTC")
  taxRate        Decimal         @default(0) @db.Decimal(5, 4)
  taxLabel       String          @default("Tax")
  taxInclusive   Boolean         @default(false)
  settings       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categories      Category[]
  kitchenTickets  KitchenTicket[]
  orders          Order[]
  products        Product[]
  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions        Session[]
  staff           Staff[]
  stampCards      StampCard[]
  tables          Table[]
  transactions    Transaction[]
  loyaltyProgram  LoyaltyProgram?
  loyaltyTiers    LoyaltyTier[]
  referrals       Referral[]
  waiterCalls     WaiterCall[]
  pricingRules    PricingRule[]
  ingredientStocks IngredientStock[]
  posIntegration  PosIntegration?

  @@index([orgId])
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  number       String
  label        String?
  qrCode       String      @unique
  nfcId        String?     @unique
  status       TableStatus @default(AVAILABLE)
  capacity     Int?
  positionX    Float?
  positionY    Float?
  createdAt    DateTime    @default(now())
  sessions     Session[]
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

model Session {
  id           String        @id @default(cuid())
  tableId      String
  restaurantId String
  status       SessionStatus @default(ACTIVE)
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  orders       Order[]
  waiterCalls  WaiterCall[]
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  table        Table         @relation(fields: [tableId], references: [id])

  @@unique([tableId, status], name: "active_session_per_table")
  @@index([restaurantId, status])
  @@index([tableId, status])
}

model Category {
  id            String     @id @default(cuid())
  restaurantId  String
  name          String
  nameAr        String?
  description   String?
  imageUrl      String?
  sortOrder     Int        @default(0)
  availableFrom String?
  availableTo   String?
  isAvailable   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products      Product[]

  @@index([restaurantId, isAvailable])
}

model Product {
  id             String          @id @default(cuid())
  restaurantId   String
  categoryId     String
  name           String
  nameAr         String?
  description    String?
  descriptionAr  String?
  price          Decimal         @db.Decimal(10, 2)
  imageUrl       String?
  isAvailable    Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  calories       Int?
  avgPrepMinutes Int             @default(10)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  modifierGroups  ModifierGroup[]
  orderItems      OrderItem[]
  ingredients     ProductIngredient[]
  posProductMaps  PosProductMap[]
  category        Category        @relation(fields: [categoryId], references: [id])
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
}

model ModifierGroup {
  id        String           @id @default(cuid())
  productId String
  name      String
  nameAr    String?
  type      ModifierType
  required  Boolean          @default(false)
  minSelect Int              @default(0)
  maxSelect Int              @default(1)
  sortOrder Int              @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   ModifierOption[]
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  nameAr          String?
  priceDelta      Decimal       @default(0) @db.Decimal(10, 2)
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   Int
  sessionId     String?
  restaurantId  String
  customerId    String?
  status        OrderStatus    @default(PENDING)
  type          OrderType      @default(DINE_IN)
  currency      String
  subtotal      Decimal        @db.Decimal(10, 2)
  tax           Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  notes         String?
  voidReason    String?
  tipAmount     Decimal        @default(0) @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  kitchenTicket KitchenTicket?
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  session       Session?       @relation(fields: [sessionId], references: [id])
  items         OrderItem[]
  payment       PaymentIntent?
  refunds       Refund[]
  tip           Tip?
  review        OrderReview?

  @@index([restaurantId, status])
  @@index([sessionId])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  unitPrice       Decimal             @db.Decimal(10, 2)
  totalPrice      Decimal             @db.Decimal(10, 2)
  notes           String?
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id])
  selectedOptions OrderItemModifier[]
}

model OrderItemModifier {
  id               String    @id @default(cuid())
  orderItemId      String
  modifierOptionId String
  name             String
  priceDelta       Decimal   @db.Decimal(10, 2)
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model PaymentIntent {
  id             String          @id @default(cuid())
  orderId        String          @unique
  provider       PaymentProvider
  providerRef    String?
  amount         Decimal         @db.Decimal(10, 2)
  currency       String
  status         PaymentStatus   @default(PENDING)
  metadata       Json?
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  settledAt      DateTime?
  order          Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([provider, providerRef])
}

model Transaction {
  id           String          @id @default(cuid())
  restaurantId String
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  currency     String
  fee          Decimal         @default(0) @db.Decimal(10, 2)
  net          Decimal         @db.Decimal(10, 2)
  refId        String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([restaurantId, type])
}

model KitchenTicket {
  id            String       @id @default(cuid())
  orderId       String       @unique
  restaurantId  String
  station       String?
  status        TicketStatus @default(PENDING)
  priority      Int          @default(0)
  prepStartedAt DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  order         Order        @relation(fields: [orderId], references: [id])
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, status])
  @@index([restaurantId, station, status])
}

model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  clerkUserId  String     @unique
  name         String
  email        String?
  role         StaffRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive])
}

model Customer {
  id               String           @id @default(cuid())
  phone            String           @unique
  name             String?
  email            String?
  createdAt        DateTime         @default(now())
  loyaltyAccounts  LoyaltyAccount[]
  profile          CustomerProfile?
  savedOrders      SavedOrder[]
  referralsGiven   Referral[]       @relation("ReferrerCustomer")
  referralsReceived Referral[]      @relation("ReferredCustomer")
}

model LoyaltyAccount {
  id            String               @id @default(cuid())
  customerId    String
  restaurantId  String
  points        Int                  @default(0)
  walletBalance Decimal              @default(0) @db.Decimal(10, 2)
  currency      String
  createdAt     DateTime             @default(now())
  customer      Customer             @relation(fields: [customerId], references: [id])
  transactions  LoyaltyTransaction[]

  @@unique([customerId, restaurantId])
  @@index([restaurantId])
}

model LoyaltyTransaction {
  id               String         @id @default(cuid())
  loyaltyAccountId String
  type             LoyaltyTxType
  pointsDelta      Int
  refOrderId       String?
  note             String?
  createdAt        DateTime       @default(now())
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])

  @@index([loyaltyAccountId])
}

model StampCard {
  id              String             @id @default(cuid())
  restaurantId    String
  customerId      String
  stamps          Int                @default(0)
  stampsRequired  Int                @default(10)
  rewardType      RewardType         @default(FREE_ITEM)
  rewardProductId String?
  rewardDiscount  Decimal?           @db.Decimal(5, 2)
  isRedeemed      Boolean            @default(false)
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions    StampTransaction[]

  @@unique([restaurantId, customerId])
  @@index([restaurantId])
}

model StampTransaction {
  id          String    @id @default(cuid())
  stampCardId String
  orderId     String
  stampsAdded Int       @default(1)
  createdAt   DateTime  @default(now())
  stampCard   StampCard @relation(fields: [stampCardId], references: [id], onDelete: Cascade)

  @@index([stampCardId])
}

model AnalyticsSnapshot {
  id                 String   @id @default(cuid())
  restaurantId       String
  date               DateTime @db.Date
  totalOrders        Int
  totalRevenue       Decimal  @db.Decimal(12, 2)
  avgOrderValue      Decimal  @db.Decimal(10, 2)
  topProducts        Json     @default("[]")
  peakHour           Int      @default(0)
  newCustomers       Int      @default(0)
  returningCustomers Int      @default(0)
  createdAt          DateTime @default(now())

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

model ZReport {
  id           String   @id @default(cuid())
  restaurantId String
  date         DateTime @db.Date
  pdfUrl       String   @default("")
  totalOrders  Int
  totalRevenue Decimal  @db.Decimal(12, 2)
  totalTax     Decimal  @db.Decimal(12, 2)
  totalRefunds Decimal  @db.Decimal(12, 2)
  netRevenue   Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

model PrinterConfig {
  id           String      @id @default(cuid())
  restaurantId String      @unique
  type         PrinterType @default(NETWORK)
  ipAddress    String?
  port         Int?        @default(9100)
  usbPath      String?
  isActive     Boolean     @default(true)
  printOnOrder Boolean     @default(true)
  printReceipt Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model CustomerDevice {
  id           String   @id @default(cuid())
  customerId   String
  onesignalId  String   @unique
  platform     String
  restaurantId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([restaurantId])
}

model ProductBranchOverride {
  id           String   @id @default(cuid())
  productId    String
  restaurantId String
  price        Decimal? @db.Decimal(10, 2)
  isAvailable  Boolean?
  createdAt    DateTime @default(now())

  @@unique([productId, restaurantId])
  @@index([restaurantId])
}

model Tip {
  id           String   @id @default(cuid())
  orderId      String   @unique
  restaurantId String
  amount       Decimal  @db.Decimal(10, 2)
  percentage   Int?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model PaymentLink {
  id            String     @id @default(cuid())
  restaurantId  String
  token         String     @unique @default(cuid())
  amount        Decimal    @db.Decimal(10, 2)
  currency      String     @default("USD")
  description   String?
  customerName  String?
  customerPhone String?
  status        LinkStatus @default(PENDING)
  expiresAt     DateTime
  paidAt        DateTime?
  orderId       String?
  createdAt     DateTime   @default(now())

  @@index([restaurantId])
  @@index([token])
}

model WebhookEndpoint {
  id           String            @id @default(cuid())
  restaurantId String
  url          String
  events       String[]
  secret       String            @default(cuid())
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  deliveries   WebhookDelivery[]

  @@index([restaurantId])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempts       Int             @default(0)
  succeededAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime        @default(now())
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([nextRetryAt])
}

model Subscription {
  id                     String       @id @default(cuid())
  orgId                  String       @unique
  planType               PlanType
  status                 SubStatus    @default(ACTIVE)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  providerSubscriptionId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  org                    Organization @relation(fields: [orgId], references: [id])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  restaurantId    String
  paymentIntentId String
  amount          Decimal      @db.Decimal(10, 2)
  reason          RefundReason
  notes           String?
  status          RefundStatus @default(PENDING_APPROVAL)
  initiatedBy     String
  approvedBy      String?
  providerRefId   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  order           Order        @relation(fields: [orderId], references: [id])

  @@index([restaurantId, status])
  @@index([orderId])
}

model NfcTag {
  id           String    @id @default(cuid())
  restaurantId String
  serialNumber String    @unique
  tableId      String?   @unique
  status       NfcStatus @default(UNASSIGNED)
  programmedAt DateTime?
  lastScanned  DateTime?
  scanCount    Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([restaurantId])
  @@index([restaurantId, status])
}

model Invoice {
  id                String        @id @default(cuid())
  orgId             String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EGP")
  status            InvoiceStatus @default(DRAFT)
  dueDate           DateTime
  paidAt            DateTime?
  pdfUrl            String?
  lineItems         Json
  providerInvoiceId String?
  createdAt         DateTime      @default(now())

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  orgId       String
  type        String
  last4       String?
  brand       String?
  isDefault   Boolean  @default(false)
  providerRef String?
  createdAt   DateTime @default(now())

  @@index([orgId])
}

model InstapayPendingConfirmation {
  id           String    @id @default(cuid())
  orderId      String    @unique
  restaurantId String
  amount       Decimal   @db.Decimal(10, 2)
  expiresAt    DateTime
  confirmedBy  String?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([restaurantId])
  @@index([expiresAt])
}

enum PlanType {
  STARTER
  GROWTH
  ENTERPRISE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  CLOSED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COOKING
  READY
  SERVED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
  STAFF_ENTRY
  EXTERNAL_POS
}

enum PaymentProvider {
  STRIPE
  PAYMOB
  FAWRY
  TABBY
  TAMARA
  INSTAPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  FEE
  PAYOUT
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  READY
  SERVED
}

enum ModifierType {
  SINGLE
  MULTI
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

enum LoyaltyTxType {
  EARN
  REDEEM
  REFUND
  ADJUSTMENT
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum RewardType {
  FREE_ITEM
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
}

enum PrinterType {
  NETWORK
  USB
}

enum LinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum RefundReason {
  WRONG_ITEM
  QUALITY_ISSUE
  CUSTOMER_CANCELLED
  DUPLICATE_PAYMENT
  OTHER
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum NfcStatus {
  UNASSIGNED
  ASSIGNED
  ACTIVE
  DAMAGED
  LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ── Phase 4 Enums ───────────────────────────────────────────────────────────

enum LoyaltyType {
  STAMP
  POINTS
  CASHBACK
  HYBRID
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum CallType {
  ASSISTANCE
  CHECK_PLEASE
  WATER
  MORE_NAPKINS
}

enum CallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum PricingType {
  PERCENTAGE_OFF
  FIXED_OFF
  FIXED_PRICE
}

enum PosProvider {
  FOODICS
  IIKO
  LIGHTSPEED
  CUSTOM
}

// ── Phase 4: Advanced Loyalty ───────────────────────────────────────────────

model LoyaltyProgram {
  id            String       @id @default(cuid())
  restaurantId  String       @unique
  type          LoyaltyType  @default(STAMP)
  pointsPerEgp  Decimal?     @db.Decimal(5, 2)
  pointsValue   Decimal?     @db.Decimal(5, 4)
  minRedemption Int?
  expiryDays    Int?
  birthdayBonus Int?
  referrerBonus Int?
  referredBonus Int?
  referralEnabled Boolean    @default(false)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model LoyaltyTier {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  nameAr       String?
  minPoints    Int
  multiplier   Decimal    @db.Decimal(3, 1)
  perks        Json       @default("[]")
  badgeColor   String     @default("#C0A060")
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, minPoints])
}

model Referral {
  id           String         @id @default(cuid())
  restaurantId String
  referrerId   String
  referredId   String
  rewardPoints Int            @default(0)
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  referrer     Customer       @relation("ReferrerCustomer", fields: [referrerId], references: [id])
  referred     Customer       @relation("ReferredCustomer", fields: [referredId], references: [id])

  @@index([restaurantId])
  @@index([referrerId])
}

// ── Phase 4: Customer Profiles ──────────────────────────────────────────────

model CustomerProfile {
  id             String    @id @default(cuid())
  customerId     String    @unique
  name           String
  email          String?
  birthdate      DateTime?
  preferredLang  String    @default("ar")
  dietaryPrefs   String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model SavedOrder {
  id           String   @id @default(cuid())
  customerId   String
  restaurantId String
  name         String
  items        Json
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, restaurantId])
}

// ── Phase 4: Smart Waiter Call ──────────────────────────────────────────────

model WaiterCall {
  id           String     @id @default(cuid())
  sessionId    String
  tableId      String
  restaurantId String
  type         CallType   @default(ASSISTANCE)
  status       CallStatus @default(PENDING)
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
  session      Session    @relation(fields: [sessionId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, status])
  @@index([sessionId])
}

// ── Phase 4: Dynamic Pricing ────────────────────────────────────────────────

model PricingRule {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  nameAr       String?
  type         PricingType @default(PERCENTAGE_OFF)
  value        Decimal     @db.Decimal(5, 2)
  daysOfWeek   Int[]
  startTime    String
  endTime      String
  productIds   String[]
  categoryIds  String[]
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive])
}

// ── Phase 4: Reviews ────────────────────────────────────────────────────────

model OrderReview {
  id              String    @id @default(cuid())
  orderId         String    @unique
  restaurantId    String
  customerId      String?
  rating          Int
  comment         String?
  tags            String[]
  isPublic        Boolean   @default(true)
  restaurantReply String?
  repliedAt       DateTime?
  createdAt       DateTime  @default(now())
  order           Order     @relation(fields: [orderId], references: [id])

  @@index([restaurantId, rating])
  @@index([restaurantId, createdAt])
}

// ── Phase 4: Inventory ──────────────────────────────────────────────────────

model IngredientStock {
  id           String              @id @default(cuid())
  restaurantId String
  name         String
  nameAr       String?
  unit         String
  currentStock Decimal             @db.Decimal(10, 3)
  minStock     Decimal             @db.Decimal(10, 3)
  costPerUnit  Decimal             @db.Decimal(10, 2)
  updatedAt    DateTime            @updatedAt
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     ProductIngredient[]

  @@index([restaurantId])
  @@index([restaurantId, currentStock])
}

model ProductIngredient {
  productId    String
  ingredientId String
  quantity     Decimal         @db.Decimal(10, 3)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   IngredientStock @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

// ── Phase 4: White-label ────────────────────────────────────────────────────

model WhiteLabelConfig {
  id             String       @id @default(cuid())
  orgId          String       @unique
  appName        String
  appNameAr      String?
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String       @default("#FF4500")
  secondaryColor String?
  customDomain   String?      @unique
  customFont     String?
  hideShataLogo  Boolean      @default(false)
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ── Phase 4: POS Integration ────────────────────────────────────────────────

model PosIntegration {
  id           String      @id @default(cuid())
  restaurantId String      @unique
  provider     PosProvider
  webhookSecret String
  inboundUrl   String?
  outboundUrl  String?
  isActive     Boolean     @default(false)
  lastSyncAt   DateTime?
  config       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// ── Phase 4.5: POS Product Mapping ─────────────────────────────────────────

model PosProductMap {
  id            String   @id @default(cuid())
  restaurantId  String
  posProvider   String
  externalSku   String
  externalName  String
  productId     String?
  isIgnored     Boolean  @default(false)
  occurrences   Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product? @relation(fields: [productId], references: [id])

  @@unique([restaurantId, posProvider, externalSku])
  @@index([restaurantId, posProvider])
  @@index([restaurantId, productId])
}
