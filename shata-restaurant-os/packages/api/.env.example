# ── Shata Restaurant OS — API Environment Variables ───────────────────────
# Copy to .env.local for local development, set in your deployment platform

# App
NODE_ENV=production
PORT=3001

# Health check — DB ping timeout for GET /api/health (default 5000ms)
HEALTH_DB_TIMEOUT_MS=5000

# Database (Supabase / Neon / PlanetScale)
DATABASE_URL=postgresql://user:password@host:5432/shata_os
DIRECT_URL=postgresql://user:password@host:5432/shata_os

# Redis (Upstash / Redis Cloud)
REDIS_URL=redis://default:password@host:6379

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
SESSION_TOKEN_SECRET=your-session-token-secret-min-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paymob (Egypt)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_INSTAPAY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=

# Fawry (Egypt)
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# Tabby BNPL (Gulf — AED, SAR, KWD, BHD)
TABBY_API_KEY=
TABBY_WEBHOOK_SECRET=

# Tamara BNPL (Gulf — AED, SAR, KWD, BHD)
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_KEY=

# Anthropic (menu AI parser)
ANTHROPIC_API_KEY=sk-ant-...

# OneSignal (push notifications)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Cloudflare R2 (media storage)
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=shata-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.shataos.com

# Thermal Printer (optional)
PRINTER_DEFAULT_IP=192.168.1.100
PRINTER_DEFAULT_PORT=9100

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
SENTRY_RELEASE=1.0.0

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# App URLs (for CORS)
CUSTOMER_APP_URL=https://order.shataos.com
DASHBOARD_URL=https://dashboard.shataos.com
KITCHEN_URL=https://kitchen.shataos.com
ADMIN_URL=https://admin.shataos.com

# InstaPay
NEXT_PUBLIC_INSTAPAY_ACCOUNT=restaurant@instapay
