{
  "name": "shata-restaurant-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate --filter=@shata/database",
    "db:push": "turbo db:push --filter=@shata/database",
    "db:migrate": "turbo db:migrate --filter=@shata/database",
    "db:migrate:deploy": "turbo db:migrate:deploy --filter=@shata/database",
    "db:studio": "turbo db:studio --filter=@shata/database",
    "db:seed": "turbo db:seed --filter=@shata/database"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0"
}
